// SHIFT UP — Schéma Prisma
// Base de données : PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTHENTIFICATION (NextAuth compatible)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// UTILISATEURS
// ============================================================

enum UserRole {
  CLIENT
  APPORTEUR
  ETUDIANT
  ADMIN
  DEVELOPER
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  password        String?
  phone           String?
  image           String?
  role            UserRole  @default(CLIENT)
  affiliationCode String    @unique @default("")
  stars           Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 2FA TOTP
  totpSecret  String? // secret chiffré (base32), null si 2FA non activé
  totpEnabled Boolean @default(false)

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Business relations
  clientProfile       ClientProfile?
  apporteurProfile    ApporteurProfile?
  etudiantProfile     EtudiantProfile?
  prestations         Prestation[]        @relation("ClientPrestations")
  assignedPrestations Prestation[]        @relation("AssignedPrestations")
  payments            Payment[]
  payoutRequests      PayoutRequest[]
  sentMessages        Message[]           @relation("SentMessages")
  receivedMessages    Message[]           @relation("ReceivedMessages")
  campaigns           Campaign[]
  chatSessions        ChatSession[]
  auditLogs           AuditLog[]
  passwordResetToken  PasswordResetToken?
  apporteurServices   ApporteurService[]
}

model ClientProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliatedBy String?
  totalSpent   Float   @default(0)
  // Informations entreprise
  companyName  String?
  rccm         String?
  ifu          String?
  cnss         String?
  rib          String?
}

model ApporteurProfile {
  id              String @id @default(cuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ifu             String
  level           String @default("BRONZE") // BRONZE | ARGENT | OR | PLATINE | DIAMANT
  totalEarnings   Float  @default(0)
  pendingEarnings Float  @default(0)
}

// ============================================================
// SERVICES APPORTEURS — Services créés et vendus par les apporteurs
// Commission SHIFT UP : 10 % sur chaque vente
// ============================================================

model ApporteurService {
  id             String   @id @default(cuid())
  apporteurId    String // userId de l'apporteur
  apporteur      User     @relation(fields: [apporteurId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       String
  features       String[] @default([])
  priceMin       Float
  priceMax       Float?
  currency       String   @default("XOF")
  duration       String? // ex: "3-5 jours", "1 semaine"
  isActive       Boolean  @default(true)
  isApproved     Boolean  @default(false) // validation admin requise
  commissionRate Float    @default(0.10) // 10 % pour SHIFT UP
  totalOrders    Int      @default(0)
  totalRevenue   Float    @default(0) // CA brut généré
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders ApporteurServiceOrder[]
}

model ApporteurServiceOrder {
  id               String           @id @default(cuid())
  serviceId        String
  service          ApporteurService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientName       String
  clientEmail      String
  clientPhone      String?
  brief            String?
  amount           Float
  commission       Float // 10 % → SHIFT UP
  apporteurRevenue Float // 90 % → apporteur
  status           String           @default("EN_ATTENTE") // EN_ATTENTE | EN_COURS | TERMINEE | ANNULEE
  paymentId        String? // ID transaction FedaPay (lien de paiement généré)
  paidAt           DateTime? // paiement confirmé (vérifié via l'API FedaPay)
  documentUrl      String? // livrable final envoyé au client
  documentName     String?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model EtudiantProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university     String?
  studentCardUrl String?
  badges         String[] @default([])
  completedTasks Int      @default(0)
}

// ============================================================
// SERVICES
// ============================================================

model Service {
  id          String   @id @default(cuid())
  domain      String
  title       String
  description String
  features    String[]
  priceMin    Float
  priceMax    Float?
  currency    String   @default("XOF")
  duration    String?
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prestations Prestation[]
}

// ============================================================
// PRESTATIONS
// ============================================================

enum PrestationStatus {
  EN_ATTENTE // Demande soumise, en attente de traitement admin
  DEVIS_ENVOYE // Admin a envoyé devis + plan — client doit valider
  EN_ATTENTE_PAIEMENT // Client a accepté le devis, doit payer l'acompte
  EN_COURS // Paiement confirmé, service en exécution
  LIVRAISON // Livrables disponibles pour le client
  REVISION // Client demande des révisions
  TERMINEE // Projet livré et accepté
  ANNULEE // Annulé
}

model Prestation {
  id           String   @id @default(cuid())
  clientId     String
  client       User     @relation("ClientPrestations", fields: [clientId], references: [id])
  serviceId    String? // Null si service personnalisé / "Autre"
  service      Service? @relation(fields: [serviceId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("AssignedPrestations", fields: [assignedToId], references: [id])

  // ── Demande client ──────────────────────────────────────────
  sector        String? // Domaine choisi
  customService String? // Intitulé libre si service "Autre"
  brief         String? // Description du besoin
  budget        String? // Fourchette budget
  deadline      String? // Délai souhaité
  company       String? // Entreprise / organisation
  phone         String? // Téléphone pour ce projet
  attachments   String[] @default([]) // URLs fichiers Supabase Storage
  customFields  Json? // Données spécifiques au type de service

  // ── Traitement admin ────────────────────────────────────────
  status    PrestationStatus @default(EN_ATTENTE)
  quote     Json? // { items:[{label,amount}], deposit, total, validity, terms }
  plan      Json? // { phases:[{title,description,duration,order}] }
  adminNote String? // Note interne admin

  // ── Suivi (legacy Json + nouveaux modèles) ──────────────────
  phases         Json @default("[]") // Gardé pour compatibilité
  currentPhase   Int  @default(0)
  globalProgress Int  @default(0)

  amount           Float     @default(0)
  amountPaid       Float     @default(0)
  notes            String?
  rating           Int?
  review           String?
  startDate        DateTime  @default(now())
  estimatedEndDate DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments         Payment[]
  prestationPhases PrestationPhase[]
  livrables        Livrable[]
}

model PrestationPhase {
  id           String     @id @default(cuid())
  prestationId String
  prestation   Prestation @relation(fields: [prestationId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  order        Int        @default(0)
  status       String     @default("PENDING") // PENDING | IN_PROGRESS | DONE
  progress     Int        @default(0)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  livrables    Livrable[]
}

model Livrable {
  id            String           @id @default(cuid())
  prestationId  String
  prestation    Prestation       @relation(fields: [prestationId], references: [id], onDelete: Cascade)
  phaseId       String?
  phase         PrestationPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  type          String // PDF | LINK | VIDEO | CODE | DESIGN | ARCHIVE
  url           String?
  isAvailable   Boolean          @default(false)
  viewedAt      DateTime?
  observation   String? // Observation client
  observationAt DateTime?
  createdAt     DateTime         @default(now())
}

// ============================================================
// PAIEMENTS
// ============================================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id           String        @id @default(cuid())
  prestationId String
  prestation   Prestation    @relation(fields: [prestationId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  amount       Float
  currency     String        @default("XOF")
  method       String // MOBILE_MONEY | CARD | BANK_TRANSFER
  provider     String // FEDAPAY | STRIPE
  status       PaymentStatus @default(PENDING)
  reference    String        @unique
  providerRef  String?       @unique
  invoiceUrl   String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ============================================================
// DEMANDES DE VERSEMENT (Apporteurs)
// ============================================================

// Statuts possibles d'une demande de versement :
//   PENDING    → soumise, en attente de traitement par l'admin
//   PROCESSING → en cours de traitement (virement initié)
//   PAID       → versée avec succès sur le Mobile Money
//   REJECTED   → rejetée (montant insuffisant, numéro invalide, etc.)

model PayoutRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  amount         Float // Montant demandé en XOF
  currency       String    @default("XOF")
  mobileProvider String // MTN_MOMO | MOOV_MONEY | WAVE | CELTIIS
  mobileNumber   String // Numéro Mobile Money du bénéficiaire
  status         String    @default("PENDING") // PENDING | PROCESSING | PAID | REJECTED
  reference      String    @unique // SU-POUT-{timestamp}-{random}
  notes          String? // Note admin (raison du rejet, etc.)
  processedAt    DateTime? // Date du traitement
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================
// MESSAGERIE INTERNE
// ============================================================

model Message {
  id             String   @id @default(cuid())
  senderId       String
  sender         User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?    @relation("ReceivedMessages", fields: [recipientId], references: [id])
  subject        String?
  content        String
  isRead         Boolean  @default(false)
  conversationId String?
  attachments    String[] @default([])
  createdAt      DateTime @default(now())
}

// ============================================================
// CHATBOT IA
// ============================================================

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  visitorId String?
  page      String?
  converted Boolean       @default(false)
  messages  ChatMessage[]
  startedAt DateTime      @default(now())
  endedAt   DateTime?
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  timestamp DateTime    @default(now())
}

// ============================================================
// BLOG
// ============================================================

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  authorId    String?
  authorName  String
  category    String
  tags        String[]  @default([])
  coverImage  String?
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  views       Int       @default(0)
  readTime    Int       @default(5)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// FAQ
// ============================================================

model FAQ {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String
  order    Int     @default(0)
  isActive Boolean @default(true)
}

// ============================================================
// NEWSLETTER
// ============================================================

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

// ============================================================
// MICRO-TACHES (Étudiant)
// ============================================================

model MicroTask {
  id             String   @id @default(cuid())
  title          String
  description    String
  type           String // DATA_ENTRY | REDACTION | RECHERCHE | TEST_LOGICIEL | AUTRE
  reward         Float
  estimatedHours Float    @default(2)
  deadline       DateTime
  status         String   @default("DISPONIBLE")
  assignedToId   String?
  deliverable    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// TÉMOIGNAGES
// ============================================================

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  avatar    String?
  content   String
  rating    Int      @default(5)
  service   String
  isVisible Boolean  @default(true)
  date      DateTime @default(now())
}

// ============================================================
// CONTACT
// ============================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  service   String?
  message   String
  isRead    Boolean  @default(false)
  reply     String?
  createdAt DateTime @default(now())
}

// ============================================================
// MOT DE PASSE OUBLIÉ
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// PRODUITS BOUTIQUE
// ============================================================

model Product {
  id          String            @id @default(cuid())
  name        String
  description String
  type        String // APP | LOGICIEL | FICHIER | LICENCE | TEMPLATE | FORMATION | AUTRE
  category    String?
  price       Float
  currency    String            @default("XOF")
  downloadUrl String? // URL de téléchargement (produits numériques)
  previewUrl  String? // Lien démo / aperçu
  thumbnail   String? // Image de couverture (URL)
  features    String[]          @default([]) // Liste des fonctionnalités
  tags        String[]          @default([])
  isActive    Boolean           @default(true)
  isFeatured  Boolean           @default(false)
  stock       Int? // null = illimité (numérique), entier = stock physique
  purchases   ProductPurchase[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductPurchase {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  userId      String
  amount      Float
  reference   String   @unique
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED
  providerRef String?  @unique // ID transaction FedaPay/Stripe (vérifié serveur)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// CAMPAGNES (Apporteur)
// ============================================================

model Campaign {
  id          String   @id @default(cuid())
  apporteurId String
  apporteur   User     @relation(fields: [apporteurId], references: [id], onDelete: Cascade)
  name        String
  channel     String // WhatsApp | LinkedIn | Facebook | Instagram | Email | Autre
  service     String?
  clicks      Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE | PAUSEE | TERMINEE
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// RESSOURCES PÉDAGOGIQUES (Étudiant)
// ============================================================

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String // VIDEO | PDF | TEMPLATE | LIEN
  category    String
  url         String
  duration    String?
  size        String?
  isNew       Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ============================================================
// FORMATIONS (Inscriptions publiques avec paiement Kkiapay)
// ============================================================

model Formation {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  titre        String
  description  String?
  dateDebut    DateTime
  dateFin      DateTime
  lieu         String
  prixFCFA     Int
  placesMax    Int                    @default(30)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inscriptions FormationInscription[]
}

model FormationInscription {
  id              String                     @id @default(cuid())
  reference       String                     @unique
  formationId     String
  formation       Formation                  @relation(fields: [formationId], references: [id])
  prenom          String
  nom             String
  email           String
  telephone       String
  ville           String
  structure       String
  poste           String
  secteur         String
  attente         String
  detail          String?
  source          String
  methodePaiement String
  typeInscription String                     @default("COMPLET") // "COMPLET" | "ACOMPTE"
  montantPaye     Int                        @default(0)
  status          FormationInscriptionStatus @default(EN_ATTENTE_PAIEMENT)
  transactionRef  String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
}

enum FormationInscriptionStatus {
  EN_ATTENTE_PAIEMENT
  PAIEMENT_CONFIRME
  ANNULEE
}

// ============================================================
// RECRUTEMENT (SHIFT UP cabinet de recrutement)
// Les offres sont définies dans lib/recrutement/offres.ts ;
// seules les candidatures sont stockées en base.
// Les pièces (PDF) sont dans le bucket Supabase PRIVÉ "recrutement".
// ============================================================

model Candidature {
  id                   String               @id @default(cuid())
  reference            String               @unique
  offreCode            String // ex. "DT"
  offreTitre           String // titre au moment du dépôt
  nom                  String
  prenoms              String
  email                String
  telephone            String
  ville                String
  nationalite          String
  diplome              String
  anneeDiplome         Int
  anneesExperience     Int
  nbProjetsSimilaires  Int
  disponibilite        String
  source               String? // affiche, whatsapp, facebook… (paramètre ?src=)
  fichiers             Json // [{ type, path, nom, taille }]
  statut               CandidatureStatut    @default(NOUVELLE)
  noteInterne          String?
  consentement         Boolean              @default(true)
  // ── Non-sélection : motifs communiqués au candidat et sort de ses données ──
  motifsNonRetenu      String[]             @default([]) // codes de lib/recrutement/motifs.ts
  commentaireNonRetenu String? // message libre ajouté au courriel
  notifieLe            DateTime? // envoi du courriel de non-sélection
  relanceLe            DateTime? // relance automatique sans réponse
  conservation         ConservationDonnees? // réponse du candidat
  conservationLe       DateTime? // date de la réponse
  conservationJusquau  DateTime? // fin de conservation (accord) ou date limite de réponse
  jetonDonnees         String?              @unique // lien personnel envoyé par courriel
  donneesSupprimeesLe  DateTime? // pièces effacées et identité anonymisée
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([offreCode])
  @@index([email])
  @@index([statut])
  @@index([conservation])
}

enum ConservationDonnees {
  EN_ATTENTE // courriel envoyé, pas encore de réponse
  ACCEPTEE // le candidat accepte que son dossier soit gardé (vivier)
  REFUSEE // le candidat demande la suppression
  EXPIREE // sans réponse dans le délai : données supprimées
}

enum CandidatureStatut {
  NOUVELLE
  EN_REVUE
  PRESELECTIONNEE
  RETENUE
  NON_RETENUE
}
