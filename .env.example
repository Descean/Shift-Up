# ============================================================
# SHIFT UP — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# ----- APPLICATION -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SHIFT UP"

# ----- NEXTAUTH -----
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ----- SUPABASE -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----- DATABASE (PostgreSQL via Supabase) -----
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ----- GOOGLE OAUTH -----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ----- GOOGLE AI (Gemini — non utilisé actuellement, réservé) -----
# Le chatbot public utilise ANTHROPIC_API_KEY (voir plus bas), pas cette clé.
GOOGLE_AI_API_KEY=your_gemini_api_key

# ----- ANTHROPIC (Claude — Dashboard IA) -----
ANTHROPIC_API_KEY=your_anthropic_api_key

# ----- FEDAPAY (Mobile Money Bénin) -----
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=your_fedapay_public_key
FEDAPAY_SECRET_KEY=your_fedapay_secret_key
# sandbox | live
FEDAPAY_ENVIRONMENT=sandbox

# ----- STRIPE (Paiements internationaux) -----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- EMAIL (Resend ou Brevo) -----
RESEND_API_KEY=re_...
EMAIL_FROM="SHIFT UP <noreply@shiftup.bj>"

# ----- BREVO (Newsletter) -----
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=your_list_id

# ----- ENCRYPTION -----
# Clé AES-256 pour chiffrement données sensibles (32 chars hex)
ENCRYPTION_KEY=your_32_char_hex_encryption_key

# ----- JWT -----
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ----- RATE LIMITING -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- ANALYTICS -----
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

